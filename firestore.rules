rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // User Profile: Strict owner-only isolation
    // Beneficiaries can ONLY read and write their own household profile
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Community Safety Alerts:
    // Public read-only for verified advisories (high tide, landslides, wildlife)
    // Write access is completely blocked for regular clients (admin/service account only)
    match /alerts/{alertId} {
      allow read: if true;
      allow write: if false;
    }

    // Block all other collections by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
